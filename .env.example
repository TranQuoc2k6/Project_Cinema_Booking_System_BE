# Cấu hình kết nối MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
# Hãy thay 'your_password' bằng mật khẩu MySQL trên máy của bạn (Ví dụ: 123456, root, admin, ...)
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/cinema_booking_system_db

